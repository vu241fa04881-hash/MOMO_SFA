{
  "name": "momo",
  "version": "1.0.0",
  "type": "module",
  "description": "MOMO - Your personal space: High-performance real-time file, clipboard, and code sharing web app",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build client",
    "build": "npm run build:client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0"
  }
}
